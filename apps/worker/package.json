{
  "name": "@docuflow/worker",
  "version": "0.1.0",
  "private": true,
  "description": "DocuFlow AI — BullMQ Worker Service",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "dev:debug": "nest start --debug --watch",
    "start": "node dist/main",
    "typecheck": "tsc --noEmit",
    "test": "jest --config jest.config.ts --passWithNoTests",
    "test:unit": "jest --config jest.config.ts --testPathPattern='src/.*.spec.ts' --passWithNoTests"
  },
  "dependencies": {
    "@docuflow/database": "workspace:*",
    "@nestjs/bull": "^10.2.3",
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@prisma/client": "^5.20.0",
    "bull": "^4.16.0",
    "ioredis": "^5.4.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@docuflow/config": "workspace:*",
    "@nestjs/cli": "^10.4.0",
    "@nestjs/schematics": "^10.1.0",
    "@nestjs/testing": "^10.4.0",
    "@types/bull": "^4.10.0",
    "@types/jest": "^29.5.13",
    "@types/node": "^22.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.0"
  }
}
