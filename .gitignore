# DocuFlow AI — .gitignore

# ─── Dependencies ─────────────────────────────────
node_modules/
.pnpm-store/

# ─── Build outputs ────────────────────────────────
dist/
.next/
out/
build/
.turbo/

# ─── Environment files ────────────────────────────
.env
.env.local
.env.*.local
# Keep .env.example and .env.test committed
!.env.example
!.env.test

# ─── Logs ─────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── Testing ──────────────────────────────────────
coverage/
.nyc_output/
playwright-report/
test-results/

# ─── Prisma ───────────────────────────────────────
# Generated client — should be regenerated, not committed
# Uncomment if you want to exclude it:
# packages/database/node_modules/.prisma/

# ─── OS files ─────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo

# ─── IDE files ────────────────────────────────────
.idea/
*.iml
.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json

# ─── Docker ───────────────────────────────────────
docker-compose.override.yml

# ─── Secrets ──────────────────────────────────────
*.pem
*.key
*.cert
*.p12
secrets/

# ─── Temporary ────────────────────────────────────
tmp/
temp/
.tmp/

# TypeScript incremental build info
*.tsbuildinfo
